{
  "name": "nexaai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"npm run electron:dev\"",
    "web:dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "electron:dev": "wait-on http://127.0.0.1:5173 && cross-env NEXA_ELECTRON_DEV=1 NEXA_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "electron:build": "echo Electron CommonJS shell ready",
    "build": "tsc -b && vite build && npm run electron:build",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.1"
  }
}