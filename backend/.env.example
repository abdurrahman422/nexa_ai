APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
SQLITE_DB_PATH=backend/data/nexaai.sqlite3
ENABLE_VOICE=false
ENABLE_WEB_INTELLIGENCE=false
ENABLE_SMART_HOME=false
ENABLE_DEV_TOOLS=true

# Optional normal conversation provider.
# Default local mode is deterministic, offline, and does not upload chat data.
NEXA_CHAT_PROVIDER=local
# Future values: openai_compatible, ollama. Configure endpoints/keys only in .env.
NEXA_CHAT_OPENAI_COMPATIBLE_BASE_URL=
NEXA_CHAT_OPENAI_COMPATIBLE_API_KEY=
NEXA_CHAT_OLLAMA_URL=

# Optional hosted LLM provider router.
# Never commit real API keys.
# The router is opt-in and should not be used for every request.
NEXA_LLM_ROUTER_ENABLED=true
NEXA_LLM_PRIMARY=gemini

GEMINI_API_KEY=
GEMINI_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=

MISTRAL_API_KEY=
MISTRAL_MODEL=

CEREBRAS_API_KEY=
CEREBRAS_MODEL=

NEXA_LLM_TIMEOUT_SECONDS=20
NEXA_LLM_MAX_RETRIES=2

# Optional search provider configuration.
# Default free mode needs no API key.
NEXA_SEARCH_PROVIDER=free

# Optional Serper.dev Google-like search provider.
# Never commit a real API key.
# NEXA_SEARCH_PROVIDER=serper
SERPER_API_KEY=your_serper_api_key_here

# Other optional providers for future use. Leave blank unless configured.
NEXA_SEARXNG_URL=
NEXA_GOOGLE_CSE_KEY=
NEXA_GOOGLE_CSE_ID=
NEXA_BRAVE_SEARCH_KEY=
NEXA_SERPAPI_KEY=
# Optional AI image generation (permission is disabled by default)
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Edge neural TTS uses no API key, but requires internet and the disabled-by-default
# edge_tts permission in Settings/Security.

# Optional Google Cloud real-time streaming STT. The credential file remains
# local and is read only by the backend.
NEXA_GOOGLE_STT_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=
